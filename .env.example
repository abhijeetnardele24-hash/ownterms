# ==============================================================================
# OwnTerms Environment Configuration
# "Your agent can use it—after it licenses it."
# ==============================================================================

# PayPal Sandbox Credentials (REST API v2)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here

# Public PayPal Client ID for frontend SDK Buttons
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here

# Google Gemini API Key (Structured Intent Extraction)
GEMINI_API_KEY=your_gemini_api_key_here
AI_EXTRACTION_MODEL=gemini-2.5-flash

# Application Configuration
APP_URL=http://localhost:3000
NODE_ENV=development

# Deterministic Fixture Mode (for offline test runs and zero-network CI)
USE_FIXTURE_AI=false
